parques_horarios = [
    ["Magic Kingdom", "09:00", "22:00"],
    ["EPCOT", "09:00", "21:00"],
    ["Hollywood Studios", "09:00", "21:00"],
    ["Animal Kingdom", "08:00", "20:00"]
]

while True:
    print("\nINGRESSOS DISNEY")
    print("1. Criar Ingresso (Create)")
    print("2. Ver Ingressos (Read)")
    print("3. Mudar Parque (Update)")
    print("4. Cancelar Ingresso (Delete)")
    print("5. Ver Horarios dos Parques (Matriz)")
    print("6. Sair")

    opcao = input("Escolha (1-6): ")

    if opcao == "1":
        nome = input("Seu nome: ")
        parque = input("Parque (ex: Magic Kingdom): ")

        # Dicionário representando um ingresso
        ingresso = {
            "nome": nome,
            "parque": parque
        }

        # Adiciona o dicionário dentro da lista
        ingressos.append(ingresso)
        print(f"Ingresso de {nome} criado para o {parque}!")

    elif opcao == "2":
        print("\nSEUS INGRESSOS")
        if len(ingressos) == 0:
            print("Nenhum ingresso cadastrado.")
        else:
            for i in range(len(ingressos)):
                item = ingressos[i]
                print(f"{i + 1}. Nome: {item['nome']} - Parque: {item['parque']}")

    elif opcao == "3":
        if len(ingressos) == 0:
            print("Nenhum ingresso para alterar.")
        else:
            for i in range(len(ingressos)):
                print(f"{i + 1}. {ingressos[i]['nome']} ({ingressos[i]['parque']})")

            numero = int(input("Qual numero do ingresso quer alterar? "))
            if numero >= 1 and numero <= len(ingressos):
                novo_parque = input("Digite o novo parque: ")
                ingressos[numero - 1]["parque"] = novo_parque
                print("Parque alterado com sucesso!")
            else:
                print("Numero invalido!")

    elif opcao == "4":
        if len(ingressos) == 0:
            print("Nenhum ingresso para apagar.")
        else:
            for i in range(len(ingressos)):
                print(f"{i + 1}. {ingressos[i]['nome']} ({ingressos[i]['parque']})")

            numero = int(input("Qual numero do ingresso quer cancelar? "))
            if numero >= 1 and numero <= len(ingressos):
                removido = ingressos.pop(numero - 1)
                print(f"Ingresso de {removido['nome']} deletado com sucesso!")
            else:
                print("Numero invalido!")

    elif opcao == "5":
        print("\nHORARIOS DOS PARQUES")
        # Percorrendo a matriz (cada linha tem [parque, abre, fecha])
        for linha in parques_horarios:
            parque_nome = linha[0]
            abre = linha[1]
            fecha = linha[2]
            print(f"{parque_nome}: abre {abre} - fecha {fecha}")

    elif opcao == "6":
        print("Ate logo!")
        break

    else:
        print("Opcao invalida! Escolha um numero de 1 a 6.")
