Variáveis para guardar os dados de um único ingresso
nome = ""
parque = ""
tem_ingresso = False

while True:
    print("\n--- INGRESSOS DISNEY ---")
    print("1. Criar Ingresso (Create)")
    print("2. Ver Ingresso (Read)")
    print("3. Mudar Parque (Update)")
    print("4. Cancelar Ingresso (Delete)")
    print("5. Sair")
    
    opcao = input("Escolha (1-5): ")

    if opcao == "1":
        if tem_ingresso == True:
            print(" Já existe um ingresso cadastrado! Cancele o atual para criar outro.")
        else:
            nome = input("Seu nome: ")
            parque = input("Parque (ex: Magic Kingdom): ")
            tem_ingresso = True
            print(f" Ingresso de {nome} criado para o {parque}!")

    elif opcao == "2":
        print("\n--- SEU INGRESSO ---")
        if tem_ingresso == False:
            print("Nenhum ingresso cadastrado.")
        else:
            print(f"Nome: {nome} - Parque: {parque}")

    elif opcao == "3":
        if tem_ingresso == False:
            print("Nenhum ingresso para alterar.")
        else:
            novo_parque = input("Digite o novo parque: ")
            parque = novo_parque
            print(" Parque alterado com sucesso!")

    elif opcao == "4":
        if tem_ingresso == False:
            print("Nenhum ingresso para apagar.")
        else:
            nome = ""
            parque = ""
            tem_ingresso = False
            print(" Ingresso deletado com sucesso!")

    elif opcao == "5":
        print("Até logo!")
        break

    else:
        print("Opção inválida! Escolha um número de 1 a 5.")
